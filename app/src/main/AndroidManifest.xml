<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="AeroVía Perú"
        android:supportsRtl="true"
        android:theme="@style/Theme.AeroViaPeru">

        <!-- Pantalla inicial de bienvenida -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Pantalla principal -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Consulta de vuelos -->
        <activity
            android:name=".VuelosActivity"
            android:exported="false" />

        <!-- Creación de reservas -->
        <activity
            android:name=".CrearReservaActivity"
            android:exported="false" />

        <!-- Listado de reservas -->
        <activity
            android:name=".MisReservasActivity"
            android:exported="false" />

        <!-- Detalle de una reserva -->
        <activity
            android:name=".DetalleReservaActivity"
            android:exported="false" />

        <!-- Edición de reservas -->
        <activity
            android:name=".EditarReservaActivity"
            android:exported="false" />

    </application>

</manifest>






