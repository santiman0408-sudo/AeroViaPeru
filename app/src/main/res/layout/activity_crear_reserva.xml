<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Completa tu reserva"
            android:textColor="#123B70"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtVueloSeleccionado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:text="Resumen del vuelo"
            android:textColor="#334155"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Nombre completo del pasajero"
            android:textColor="#334155"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtClienteNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej. Juan Pérez"
            android:inputType="textCapWords"
            android:minHeight="52dp"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Teléfono de contacto"
            android:textColor="#334155"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtTelefono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej. 987654321"
            android:inputType="phone"
            android:minHeight="52dp"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnRegistrarReserva"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#1455A0"
            android:text="REGISTRAR RESERVA"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>
